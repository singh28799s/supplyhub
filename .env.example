# Copy this file to .env for local development. Never commit .env.
DJANGO_ENV=development
DEBUG=True
SECRET_KEY=replace-with-a-random-local-development-key
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Leave empty for the existing local SQLite database (db.sqlite3).
DATABASE_URL=

# Optional Cloudinary media storage. Leave all three blank for local media/.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Optional email delivery. By default, development email is printed in the runserver terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=SupplyHub <no-reply@supplyhub.local>
SUPPLYHUB_ADMIN_EMAIL=

# Optional integrations; never put production credentials in this file or source control.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
DELHIVERY_API_TOKEN=
DELHIVERY_API_BASE_URL=https://track.delhivery.com
DELHIVERY_PICKUP_LOCATION=
SUPPLYHUB_SELLER_COMMISSION_PERCENT=5.00
SUPPLYHUB_PAYOUT_HOLD_DAYS=7

# Production-only examples (set these in Render's Environment tab, not .env):
# DJANGO_ENV=production
# DEBUG=False
# SECRET_KEY=<generate-a-unique-secret>
# DATABASE_URL=<Render-PostgreSQL-internal-connection-string>
# ALLOWED_HOSTS=supplyhub-5bdm.onrender.com
# CSRF_TRUSTED_ORIGINS=https://supplyhub-5bdm.onrender.com
# CLOUDINARY_CLOUD_NAME=<cloud-name>
# CLOUDINARY_API_KEY=<api-key>
# CLOUDINARY_API_SECRET=<api-secret>
